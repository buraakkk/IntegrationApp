<mvc:View controllerName="integration.controller.Integration"
          xmlns="sap.m"
          xmlns:core="sap.ui.core"
          xmlns:mvc="sap.ui.core.mvc"
          xmlns:t="sap.ui.table"
          xmlns:u="sap.ui.unified"
          xmlns:comp="sap.ui.comp"
          xmlns:f="sap.f"
          xmlns:fb="sap.ui.comp.filterbar"
          xmlns:svm="sap.ui.comp.smartvariants"
          >
    <Page id="_IDGenPage1"
        class="sapUiContentPadding sapUiResponsivePadding--header sapUiResponsivePadding--subHeader sapUiResponsivePadding--content sapUiResponsivePadding--footer"
        showNavButton="false">
        <content>
            <Table id="_IDGenTable1" enableBusyIndicator="true"
                   items="{ path: 'artifactsModel>/', sorter: { path: 'Name'}, events: {change: '.onItemsBindingChange'} }"
                  >
                <headerToolbar>
                    <OverflowToolbar id="_ovToolbar">
                        <content>
                            <Title id="_idTitle1" text="{worklistView>/worklistTableTitle}"/>
                            <ToolbarSpacer id="_idToolbarSpacer1" /> 
                            <SearchField  id="searchField" width="350px" search=".onSearch" tooltip="{i18n>filterByfree}"/>
                            <MultiComboBox id="packageIdComboBox" width="350px" selectionChange=".onFilterChange" items="{path: 'packages>/'}" tooltip="{i18n>filterByPackageId}">
                                 <core:Item id="_IDGenItem1" key="{packages>Id}" text="{packages>Name}" />
                            </MultiComboBox>
                            <Button id="_PersButton" icon="sap-icon://action-settings" type="Transparent" press="openPersoDialog"/>
                            <Button id="_RefreshButton" icon="sap-icon://refresh" type="Transparent" press="onRefreshData"/>
                            <Button id="_ExportButton" icon="sap-icon://excel-attachment" type="Transparent" press="onExportToExcel"/>
                        </content>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column id="_IDGenColumn1" minScreenWidth="Tablet" demandPopin="true" visible="false">
                        <Text id="_IDGenText1" text="Artifact ID" />
                    </Column>
                    <Column id="_IDGenColumn2" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText2" text="Artifact Name"/>
                    </Column>
                    <Column id="_IDGenColumn14" minScreenWidth="Tablet" demandPopin="true"> 
                        <Text id="_IDGenText14" text="Package Name"/>
                    </Column>
                    <Column id="_IDGenColumn4" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText4" text="Design time(D)"/>
                    </Column>
                    <Column id="_IDGenColumn9" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText9" text="Runtime(D)"/>
                    </Column>
                     <Column id="_IDGenColumn16" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText16" text="Design time(Q)"/>
                    </Column>
                    <Column id="_IDGenColumn17" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText17" text="Runtime(Q)"/>
                    </Column>
                     <Column id="_IDGenColumn18" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText20" text="Design time(T)"/>
                    </Column>
                    <Column id="_IDGenColumn19" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="_IDGenText21" text="Runtime(T)"/>
                    </Column>
                     <Column id="_IDGenColumn11" minScreenWidth="Tablet" demandPopin="true" visible="false" >
                        <Text id="_IDGenText11" text="Description"/>
                    </Column>
                     <Column id="_IDGenColumn3" minScreenWidth="Tablet" demandPopin="true" visible="false"> 
                        <Text id="_IDGenText3" text="Package ID"/>
                    </Column>
                    <Column id="_IDGenColumn10" minScreenWidth="Tablet" demandPopin="true" visible="false">
                        <Text id="_IDGenText10" text="Created Date"/>
                    </Column>
                    <Column id="_IDGenColumn23" minScreenWidth="Tablet" demandPopin="true" visible="false">
                        <Text id="_IDGenText23" text="Status"/>
                    </Column>
                     <Column id="_IDGenColumn24" minScreenWidth="Tablet" demandPopin="true" visible="false">
                        <Text id="_IDGenText24" text="Status(Q)"/>
                    </Column>
                     <Column id="_IDGenColumn25" minScreenWidth="Tablet" demandPopin="true" visible="false">
                        <Text id="_IDGenText25" text="Status(T)"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem id="_IDGenColumnListItem1" vAlign="Middle">
                        <cells>
                            <Text id="_IDGenText6" text="{artifactsModel>Id}"/>
                            <Text id="_IDGenText5" text="{artifactsModel>Name}"/>
                            <Text id="_IDGenText15" text="{artifactsModel>PackageName}"/>
                            <Text id="_IDGenText7" text="{artifactsModel>Version}"/>
                            <ObjectStatus id="_IDGenObjectStatus1" text="{artifactsModel>RuntimeVersion}" state="{= ${artifactsModel>Status} === 'STARTED' ? 'Success' : ${artifactsModel>Status} === 'ERROR' ? 'Error' : 'None'}"/>

                            <HBox id="_IDGenHBox1" tooltip="{= ${artifactsModel>Version} !== ${artifactsModel>designtimeQuality} ? 'Desingtime(D) Version does not match Desingtime Quality' : 'Desingtime(D) Version matches Desingtime Quality'}">
                                <core:Icon id="_IDGenIcon1" 
                                    src="{= !!${artifactsModel>designtimeQuality} &amp;&amp; ${artifactsModel>Version} !== ${artifactsModel>designtimeQuality} ? 'sap-icon://status-critical' : '' }"
                                    color="red"
                                    visible="{= ${artifactsModel>Version} !== ${artifactsModel>designtimeQuality}}"
                                    size="1em"
                                />
                                <Text id="_IDGenText18" text="{artifactsModel>designtimeQuality}"/>
                            </HBox>

                            <HBox id="_IDGenHBox2" tooltip="{= ${artifactsModel>RuntimeVersion} !== ${artifactsModel>runtimeQuality} ? 'Runtime(D) Version does not match Runtime Quality' : 'Runtime(D) Version matches Runtime Quality'}">
                                <core:Icon id="_IDGenIcon2" 
                                    src="{= !!${artifactsModel>runtimeQuality} &amp;&amp; ${artifactsModel>RuntimeVersion} !== ${artifactsModel>runtimeQuality} ? 'sap-icon://status-critical' : '' }"
                                    color="red"
                                    visible="{= ${artifactsModel>RuntimeVersion} !== ${artifactsModel>runtimeQuality}}"
                                    size="1em"
                                />
                                 <ObjectStatus id="_IDGenObjectStatus2" text="{artifactsModel>runtimeQuality}" state="{= ${artifactsModel>QualityStatus} === 'STARTED' ? 'Success' : ${artifactsModel>Status} === 'ERROR' ? 'Error' : 'None'}"/>
                            </HBox >

                            <HBox id="_IDGenHBox3" tooltip="{= ${artifactsModel>Version} !== ${artifactsModel>designtimeTest} ? 'Desingtime(D) Version does not match Desingtime Test' : 'Desingtime(D) Version matches Desingtime Test'}">
                                <core:Icon id="_IDGenIcon3" 
                                     src="{= !!${artifactsModel>designtimeTest} &amp;&amp; ${artifactsModel>Version} !== ${artifactsModel>designtimeTest} ? 'sap-icon://status-critical' : '' }"  
                                    color="red"
                                    visible="{= ${artifactsModel>Version} !== ${artifactsModel>designtimeTest}}"
                                    size="1em"
                                />
                                <Text id="_IDGenText22" text="{artifactsModel>designtimeTest}"/>
                            </HBox>

                             <HBox id="_IDGenHBox4" tooltip="{= ${artifactsModel>RuntimeVersion} !== ${artifactsModel>runtimeTest} ? 'Runtime(D) Version does not match Runtime Test' : 'Runtime(D) Version matches Runtime Test'}">
                                <core:Icon id="_IDGenIcon4" 
                                     src="{= !!${artifactsModel>runtimeTest} &amp;&amp; ${artifactsModel>RuntimeVersion} !== ${artifactsModel>runtimeTest} ? 'sap-icon://status-critical' : '' }"  
                                    color="red"
                                    visible="{= ${artifactsModel>RuntimeVersion} !== ${artifactsModel>runtimeTest}}"
                                    size="1em"
                                />
                                <ObjectStatus id="_IDGenObjectStatus3" text="{artifactsModel>runtimeTest}" state="{= ${artifactsModel>TestStatus} === 'STARTED' ? 'Success' : ${artifactsModel>Status} === 'ERROR' ? 'Error' : 'None'}"/>
                            </HBox>

                            <Text id="_IDGenText13" text="{artifactsModel>Description}"/>
                            <Text id="_IDGenObjectIdentifier1" text="{artifactsModel>PackageId}"/>
                            <Text id="_IDGenText12" text="{artifactsModel>CreatedAt}"/>
                            <Text id="_IDGenText26" text="{artifactsModel>Status}"/>
                            <Text id="_IDGenText27" text="{artifactsModel>QualityStatus}"/>
                            <Text id="_IDGenText28" text="{artifactsModel>TestStatus}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
     </Page>
</mvc:View>
